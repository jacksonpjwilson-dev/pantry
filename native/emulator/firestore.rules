rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    // Candidate additive Pantry rules. Merge with existing Logbook rules; do not deploy this file as a replacement.
    match /pantry/{uid} {
      allow read, write: if owner(uid);
      match /items/{id} { allow read, write: if owner(uid); }
      match /ledger/{id} { allow read, create, update: if owner(uid); allow delete: if false; }
      match /meta/{id} { allow read, write: if owner(uid); }
    }
    match /logbookV2/{uid} { allow get: if owner(uid); allow list, write: if false; }
  }
}
